#!/usr/bin/env python3
"""
warp-layout-restore — rebuild the layout warp-layout-recorder kept.

After a battery death (or any restart where Warp's own restore came back short), this
reopens the conversations that were open at the last snapshot — each in its own tab,
named "GROUP · name" — through the one mechanism proven to work, Warp Tab Configs
(warp://tab_config/<stem>, the same path restore-plan uses). Warp's deep link for
multi-window Launch Configs is broken (2026-11-02, "couldn't turn launch link into
path" in Warp's own log), so tab-by-tab is how groups travel: in the tab's title.

What it will NOT do, ever:
  * reopen a conversation that is running anywhere (guard-checked before EVERY open —
    a second writer corrupts the transcript; that is the whole reason this tool exists)
  * open anything not in the snapshot (it restores the recorded delta, not a guess)
  * open a conversation whose folder is gone (the tab would be a dead shell)

By default it only REPORTS. --open does the work, one tab at a time, re-checking
liveness immediately before each open, in snapshot order, grouped by group.

Usage:
  warp-layout-restore                 # show the plan: what is missing, what it would open
  warp-layout-restore --open          # open the missing conversations
  warp-layout-restore --open --group "HW DEV"
  warp-layout-restore --match <text>  # narrow to conversations matching a name/cwd fragment
"""
import json
import os
import shlex
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
RECOV = os.path.join(HOME, ".superset-recovery")
SNAP = os.path.join(RECOV, "layout-snapshots", "current.json")
TAB_DIR = os.path.join(HOME, ".warp", "tab_configs")
LIB = os.path.join(RECOV, "resume-lib.py")
MARKER = "# Generated by pane-resume; safe to replace."
STEM_PREFIX = "restore_"
AUTO_LOG = os.path.join(HOME, ".superset-recovery", "auto-restore.log")


def _auto_log(msg):
    """--auto runs detached with no one watching stdout; its decisions land here so the
    owner can see what the machine did on its own (and any session can audit it)."""
    try:
        with open(AUTO_LOG, "a") as fh:
            fh.write("%s %s\n" % (time.strftime("%F %T"), msg))
    except OSError:
        pass


def load_snapshot():
    if not os.path.exists(SNAP):
        return None
    try:
        with open(SNAP) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def conversation_live(sid):
    """True/False via pane-resume's own exact liveness check; None when the probe
    itself failed — callers must then refuse to act rather than guess (the same
    discipline restore-plan's busy_sids() uses: cannot tell → offer nothing)."""
    try:
        r = subprocess.run([sys.executable, LIB, "conversation-live", sid],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return None
        return r.stdout.strip() in ("1", "2")
    except Exception:
        return None


def label_for(sid, cwd):
    """The conversation's real name via pane-resume's shared naming rule."""
    try:
        r = subprocess.run([sys.executable, LIB, "label", sid],
                           capture_output=True, text=True, timeout=30)
        name = r.stdout.strip()
    except Exception:
        name = ""
    return name or os.path.basename(cwd or "") or "(unnamed)"


def guard_cmd(sid):
    """The live-guard as plain shell words with NO quoting of our own path (it has no
    spaces) — shlex.quote would emit double quotes, and embedding those inside a TOML
    basic string breaks the whole file. python3 argv form avoids quoting entirely."""
    return "%s %s guard %s" % (sys.executable, LIB, sid)


def launcher():
    has_cc = subprocess.run(
        ["zsh", "-ic", "w=$(whence -w cc 2>/dev/null); "
                       "[[ \"$w\" == *': function' || \"$w\" == *': alias' ]]"],
        capture_output=True,
        env={**os.environ, "_SUPERSET_RESUME_DONE": "1"}).returncode == 0
    return "cc all --resume %s" if has_cc else "claude --resume %s"


def plan_rows(snap, match=None, group=None):
    """Snapshot conversations worth reopening: deduped by sid, folder present, not in a
    temp dir, narrowed by --match/--group. Group name rides along for the title."""
    seen = set()
    rows = []
    for w in snap.get("windows", []):
        gnames = {g["id"]: (g["name"] or "") for g in w.get("groups", [])}
        for t in w.get("tabs", []):
            gname = gnames.get(t.get("group_id"), "")
            if group and group.lower() not in gname.lower():
                continue
            for p in t.get("panes", []):
                sid = p.get("session")
                if not sid or sid in seen:
                    continue
                seen.add(sid)
                cwd = p.get("cwd") or ""
                if not cwd or not os.path.isdir(cwd):
                    continue
                if cwd.startswith(("/var/folders/", "/private/var/folders/", "/tmp/", "/private/tmp/")):
                    continue
                label = label_for(sid, cwd)
                if match and match.lower() not in label.lower() and match.lower() not in cwd.lower():
                    continue
                rows.append({"sid": sid, "cwd": cwd, "label": label, "group": gname or "-"})
    return rows


def write_tab_config(row, launch):
    stem = STEM_PREFIX + row["sid"][:8]
    title = ("%s · %s" % (row["group"], row["label"]))[:60]
    def q(s):
        return json.dumps(s, ensure_ascii=False)
    body = (MARKER + "\n"
            + "name = " + q(title) + "\n"
            + "title = " + q(title) + "\n\n"
            + "[[panes]]\n"
            + 'id = "main"\n'
            + 'type = "terminal"\n'
            + "directory = " + q(row["cwd"]) + "\n"
            + "commands = [" + q(launch(row["sid"])) + "]\n")
    os.makedirs(TAB_DIR, exist_ok=True)
    path = os.path.join(TAB_DIR, stem + ".toml")
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(body)
    os.replace(tmp, path)
    return stem


def main():
    args = sys.argv[1:]
    do_open = "--open" in args
    auto = "--auto" in args          # fired by the restore hook, not by a human
    match = group = None
    for flag, setter in (("--match", "match"), ("--group", "group")):
        if flag in args:
            i = args.index(flag)
            if i + 1 < len(args):
                if setter == "match":
                    match = args[i + 1]
                else:
                    group = args[i + 1]
    snap = load_snapshot()
    if snap is None:
        print("No snapshot at %s — run warp-layout-recorder first." % SNAP)
        return 1
    rows = plan_rows(snap, match, group)
    if not rows:
        print("Nothing in the snapshot matches%s%s." %
              (" group=" + group if group else "", " match=" + match if match else ""))
        return 0
    statuses = [conversation_live(r["sid"]) for r in rows]
    if any(s is None for s in statuses):
        # Cannot tell what is open right now. Opening anyway risks a second writer on a
        # live transcript — the exact corruption this whole toolkit exists to prevent.
        # In --auto mode this is a RETRY moment, not a dead end: the restore wave just
        # started agents seconds ago and the process table can still be in flux, so
        # back off and try again (bounded), and only then leave the list for the report.
        print("Cannot tell which conversations are open right now, so nothing is opened.")
        print("(Reopening one that is already open makes both copies write to the same")
        print(" transcript, which corrupts it.) Try again in a moment.")
        if auto:
            for wait in (20, 40, 60):
                time.sleep(wait)
                statuses = [conversation_live(r["sid"]) for r in rows]
                if not any(s is None for s in statuses):
                    break
            else:
                _auto_log("probe never settled — nothing auto-opened this run")
                return 1
        else:
            return 1
    live = [r for r, s in zip(rows, statuses) if s]
    missing = [r for r, s in zip(rows, statuses) if not s]
    print("Snapshot %s: %d conversation(s) recorded" % (snap.get("ts", "?"), len(rows)))
    print("  %d already running — left alone" % len(live))
    print("  %d missing — candidates to reopen" % len(missing))
    for r in missing:
        print("    %-12s %s" % (r["group"], r["label"]))
    if not missing:
        return 0
    if not do_open:
        print("\nDry run. Re-run with --open to reopen the missing ones.")
        return 0
    launch = launcher()
    opened = skipped = 0
    for r in missing:
        # Re-check liveness NOW, not from the plan pass above: minutes pass between
        # listing and opening, and the owner may have reopened one by hand meanwhile.
        s = conversation_live(r["sid"])
        if s is None:
            print("    skipped %s — cannot tell what is open right now" % r["label"])
            if auto:
                _auto_log("probe unsettled mid-open at %s — stopped opening" % r["sid"][:8])
                break
            skipped += 1
            continue
        if s:
            print("    skipped %s — it became open while this was running" % r["label"])
            skipped += 1
            continue
        stem = write_tab_config(r, lambda s: guard_cmd(s) + " && " + launch % s)
        subprocess.run(["open", "-b", "dev.warp.Warp-Stable",
                        "warp://tab_config/%s" % stem], check=False)
        print("    opening %-12s %s" % (r["group"], r["label"]))
        if auto:
            _auto_log("opened %s (%s)" % (r["sid"][:8], r["label"][:40]))
        opened += 1
        subprocess.run(["sleep", "3"])
    print("\n  %d opened%s." % (opened, ", %d skipped" % skipped if skipped else ""))
    print("  Tabs are titled 'GROUP · name' — Warp's link for grouped windows is broken,")
    print("  so drag them into their groups once (one pass, or use the title as the map).")
    print("  Clean up afterwards:  restore-plan --clean")
    return 0


if __name__ == "__main__":
    sys.exit(main())

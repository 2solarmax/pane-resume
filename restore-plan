#!/usr/bin/env python3
"""
restore-plan — rebuild a whole workspace of conversations in ONE action, instead of
opening panes one at a time.

Writes a Warp Launch Configuration: a window of tabs, each split into panes, each pane
opening one conversation. You then run it once from Warp's command palette and every
session comes back, each in its own pane, grouped by project.

  restore-plan                 TICK THE ONES YOU WANT from the last 24h, then Enter.
                               (space toggles · a all · n none · / filter · q cancels)
  restore-plan -d 3            look back 3 days instead
  restore-plan --all           skip the checkboxes, take the whole window
  restore-plan --all-known     include ones that already have a pane (default: skip)
  restore-plan --per-tab 3     group N sessions per tab as split panes
                               (default 1 = one tab per session, tab named after it)
  restore-plan --name X        launch-configuration name (default: restore-sessions)
  restore-plan --dry-run       print the plan, write nothing
  restore-plan --limit 12      non-interactive: the 12 most recent
  restore-plan --match gmail   only conversations whose name or folder matches
  restore-plan --pick 1,4,7-9  non-interactive: these rows from the printed list

Never offers a conversation that is open right now — reopening one makes both copies
write to the same transcript at once, which corrupts it.

Then in Warp:  ⌘P → "Launch Configuration" → pick the name it prints.
"""
import os, sys, json, glob, time, shlex

HOME = os.path.expanduser("~")
PROJ = os.path.join(HOME, ".claude", "projects")
RECOV = os.path.join(HOME, ".superset-recovery")
LAUNCH_DIR = os.path.join(HOME, ".warp", "launch_configurations")

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import titlelib            # what to CALL a conversation — shared with pane-title.py

# Line 1 of any launch configuration this tool writes. It is how a later run knows the file
# is ours to replace — a file without it was written by a human, and is moved aside instead.
MARKER = "# Generated by pane-resume; safe to replace."

# Working directories that are throwaway by construction. A conversation started in one
# was about a temp file, not a project; its folder is usually gone by the time you would
# restore it, and a tab named after a /var/folders path tells you nothing.
TEMP_ROOTS = ("/var/folders/", "/private/var/folders/", "/tmp/", "/private/tmp/")


def scan(path, limit=60):
    """What to call a conversation, where it lived, and whether it is worth reopening.

    The cwd comes from the transcript's own record — authoritative. Deriving it from
    Claude's lossy directory encoding instead is what used to break on worktrees, whose
    names contain the very character the encoding replaces."""
    tr = titlelib.read_transcript(path)
    # Would rather say "(unnamed)" than invent a name out of a paste.
    return titlelib.name_from(tr, limit, "(unnamed)"), tr.cwd, tr.users


def claimed():
    out = set()
    for sub in ("warp-bindings", "warp-last"):
        d = os.path.join(RECOV, sub)
        try:
            for pane in os.listdir(d):
                parts = open(os.path.join(d, pane)).read().strip().split("\t")
                if len(parts) > 1:
                    out.add(parts[1])
        except OSError:
            continue
    return out


def live_now():
    """Which conversations are OPEN right now, and how many open ones we cannot name.

    This is the one check that protects your data. Two copies of the same conversation
    running at once both append to the same transcript file and interleave into nonsense —
    so anything currently open must never be offered for reopening.

    Two kinds of open conversation, and they need different handling:
      - resumed  — the id is right there in how the process was started, so we know it
      - freshly started — the id was assigned after launch, so nothing outside can name it.
        For those we only learn HOW MANY there are, and treat the same number of
        most-recently-written transcripts as off limits. Conservative on purpose: the cost
        of holding one back is that you reopen it yourself; the cost of getting it wrong is
        a damaged transcript.

    Reads only how each process was started, and extracts only the conversation id — never
    anything else from the process table, which on this machine can carry secrets.
    """
    import re, subprocess
    agent_bin, resumed, running = "/.local/bin/claude", set(), 0
    try:
        out = subprocess.run(["ps", "-Ao", "pid=,command="],
                             capture_output=True, text=True, timeout=15).stdout
    except Exception:
        # UNKNOWN, which is NOT the same as "nothing is running" — and the difference is the
        # whole guard. Returning an empty set here would have read as "everything is safe to
        # reopen" at the exact moment we can no longer tell, which is backwards.
        return None
    for line in out.splitlines():
        head = line.strip().split(" ", 1)
        if len(head) < 2 or not head[1].startswith(("/Users", "/usr", "/opt", "/bin")):
            continue
        cmd = head[1]
        if agent_bin not in cmd.split(" ", 1)[0]:
            continue             # not an agent process — ignore it entirely
        running += 1
        m = re.search(r"--resume\s+([0-9a-fA-F-]{36})", cmd)
        if m:
            resumed.add(m.group(1).lower())
    return resumed, max(0, running - len(resumed))


FRESHLY_WRITTEN = 900          # 15 minutes


def busy_sids():
    """Every conversation that must be left alone because it may be open right now.

    Resumed ones are known by name. For the freshly-started ones — whose id exists only
    inside the process — we fall back to the one thing visible from outside: an open
    conversation is being written to. So while ANY agent is running, a transcript touched in
    the last few minutes is treated as possibly-open.

    Returns None when it genuinely cannot tell (the process probe failed). Callers must
    treat that as "do not act" — never as "nothing is open".

    This deliberately does nothing in the case that matters most. After a crash or restart
    no agent is running, so nothing is held back and the whole workspace is offered — while
    during normal use, when reopening something would do damage, it stays cautious."""
    live = live_now()
    if live is None:
        return None
    resumed, unnamed = live
    out = set(resumed)
    if unnamed <= 0:
        return out
    now = time.time()
    for f in glob.glob(os.path.join(PROJ, "*", "*.jsonl")):
        try:
            if now - os.path.getmtime(f) < FRESHLY_WRITTEN:
                out.add(os.path.basename(f)[:-6])
        except OSError:
            continue
    return out


def collect(days, include_known):
    known = set() if include_known else claimed()
    # --all-known widens what you SEE; it never lets an open conversation through.
    busy = busy_sids()
    if busy is None:
        return None          # cannot tell what is open -> offer nothing, say so
    known |= busy
    cutoff = time.time() - days * 86400
    rows = []
    for f in glob.glob(os.path.join(PROJ, "*", "*.jsonl")):
        try:
            m = os.path.getmtime(f)
        except OSError:
            continue
        if m < cutoff:
            continue
        sid = os.path.basename(f)[:-6]
        if sid in known:
            continue
        label, cwd, users = scan(f)
        if users < 2:
            continue          # one-shot / throwaway session — nothing worth reopening
        if not cwd or not os.path.isdir(cwd):
            continue          # its folder is gone (deleted worktree) — can't reopen it there
        if cwd.startswith(TEMP_ROOTS):
            continue          # started in a temp dir — a throwaway, not a project
        rows.append((m, sid, cwd, label))
    rows.sort(reverse=True)
    return rows


def build(rows, per_tab, name, launcher):
    by_proj = {}
    for m, sid, cwd, label in rows:
        by_proj.setdefault(cwd, []).append((sid, label))
    lines = [MARKER, "---", f"name: {name}", "windows:", "  - tabs:"]
    n_panes = 0
    for cwd, items in by_proj.items():
        short = os.path.basename(cwd) or cwd
        for chunk_i in range(0, len(items), per_tab):
            chunk = items[chunk_i:chunk_i + per_tab]
            # One session in the tab -> name the TAB after the conversation (this is how
            # you recognise it at a glance). Several -> name it after the project, and each
            # PANE titles itself with its own conversation via the pane-label hook.
            if len(chunk) == 1:
                title = chunk[0][1]
            else:
                title = short if len(items) <= per_tab else f"{short} {chunk_i//per_tab + 1}"
            lines.append(f"      - title: {json.dumps(title)}")
            lines.append("        layout:")
            if len(chunk) == 1:
                sid, label = chunk[0]
                lines.append(f"          cwd: {json.dumps(cwd)}")
                lines.append("          commands:")
                lines.append(f"            - exec: {json.dumps(launcher % sid)}")
                n_panes += 1
            else:
                lines.append("          split_direction: horizontal")
                lines.append("          panes:")
                for sid, label in chunk:
                    lines.append(f"            - cwd: {json.dumps(cwd)}")
                    lines.append("              commands:")
                    lines.append(f"                - exec: {json.dumps(launcher % sid)}")
                    n_panes += 1
    return "\n".join(lines) + "\n", n_panes


def choose(rows):
    """Tick the conversations you want back. Space toggles, Enter confirms.

    A time window is not a workspace. Asking for "everything from the last 24h" gives you
    46 tabs; asking for them one at a time is just typing the resume yourself. What you
    actually want is to look at the list and point at six of them — so this is that list,
    with checkboxes.

    Returns the chosen rows, or None if you backed out (which must open nothing)."""
    import curses

    picked = set()
    state = {"cancel": False}

    def ui(stdscr):
        curses.curs_set(0)
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        top, cur, filt = 0, 0, ""
        while True:
            stdscr.erase()
            h, w = stdscr.getmaxyx()
            shown = [i for i, r in enumerate(rows)
                     if not filt or filt.lower() in r[3].lower()
                     or filt.lower() in os.path.basename(r[2]).lower()]
            if not shown:
                shown = []
            body = max(1, h - 4)
            if cur >= len(shown):
                cur = max(0, len(shown) - 1)
            if cur < top:
                top = cur
            if cur >= top + body:
                top = cur - body + 1

            head = f" {len(picked)} selected of {len(rows)}"
            if filt:
                head += f"   filter: {filt}"
            stdscr.addnstr(0, 0, head.ljust(w - 1), w - 1, curses.A_BOLD)
            stdscr.addnstr(1, 0, " space toggle · a all · n none · / filter · enter open · q cancel"
                           .ljust(w - 1), w - 1, curses.A_DIM)

            for line, idx in enumerate(shown[top:top + body]):
                m, sid, cwd, label = rows[idx]
                mark = "x" if idx in picked else " "
                when = time.strftime("%a %H:%M", time.localtime(m))
                folder = os.path.basename(cwd)[:20]
                text = f" [{mark}] {when:>9}  {folder:20}  {label}"
                attr = curses.A_REVERSE if idx == shown[cur] else curses.A_NORMAL
                stdscr.addnstr(2 + line, 0, text.ljust(w - 1), w - 1, attr)

            stdscr.refresh()
            try:
                k = stdscr.getch()
            except KeyboardInterrupt:
                state["cancel"] = True
                return

            if k in (curses.KEY_DOWN, ord("j")):
                cur = min(cur + 1, max(0, len(shown) - 1))
            elif k in (curses.KEY_UP, ord("k")):
                cur = max(cur - 1, 0)
            elif k == curses.KEY_NPAGE:
                cur = min(cur + body, max(0, len(shown) - 1))
            elif k == curses.KEY_PPAGE:
                cur = max(cur - body, 0)
            elif k == ord(" "):
                if shown:
                    i = shown[cur]
                    picked.discard(i) if i in picked else picked.add(i)
                    cur = min(cur + 1, len(shown) - 1)     # ticking runs down the list
            elif k == ord("a"):
                picked.update(shown)
            elif k == ord("n"):
                for i in shown:
                    picked.discard(i)
            elif k == ord("/"):
                # Type to narrow; Enter accepts the filter, Esc clears it.
                buf = ""
                while True:
                    stdscr.addnstr(h - 1, 0, ("/" + buf).ljust(w - 1), w - 1)
                    stdscr.refresh()
                    c = stdscr.getch()
                    if c in (10, 13):
                        break
                    if c == 27:
                        buf = ""
                        break
                    if c in (curses.KEY_BACKSPACE, 127, 8):
                        buf = buf[:-1]
                    elif 32 <= c < 127:
                        buf += chr(c)
                filt, cur, top = buf, 0, 0
            elif k in (10, 13):
                return
            elif k in (ord("q"), 27):
                state["cancel"] = True
                return

    try:
        curses.wrapper(ui)
    except Exception:
        return "NOUI"          # no usable terminal — caller falls back to the printed list
    if state["cancel"]:
        return None
    return [rows[i] for i in sorted(picked)]


def parse_pick(spec, n):
    """"1,4,7-9" -> the row numbers you actually want, 1-based, in list order.

    Restoring one conversation at a time is no better than typing the resume yourself; the
    point of a plan is to get a WORKSPACE back in one action. But a whole time-window is
    almost always more than you want open. This is the middle: read the numbered list once,
    name the ones you want, get exactly those."""
    want = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part[1:]:
            lo, _, hi = part.partition("-")
            try:
                lo, hi = int(lo), int(hi)
            except ValueError:
                continue
            want.extend(range(min(lo, hi), max(lo, hi) + 1))
        else:
            try:
                want.append(int(part))
            except ValueError:
                continue
    seen, out = set(), []
    for x in want:
        if 1 <= x <= n and x not in seen:
            seen.add(x); out.append(x)
    return out


def main():
    a = sys.argv[1:]
    days, per_tab, name, dry, include_known = 1.0, 1, "restore-sessions", False, False
    limit, match, pick = 0, "", ""
    interactive = True
    i = 0
    while i < len(a):
        if a[i] == "-d" and i + 1 < len(a):
            i += 1; days = float(a[i])
        elif a[i] == "--limit" and i + 1 < len(a):
            i += 1
            try: limit = max(0, int(a[i]))
            except ValueError: limit = 0
        elif a[i] == "--match" and i + 1 < len(a):
            i += 1; match = a[i].lower()
        elif a[i] == "--pick" and i + 1 < len(a):
            i += 1; pick = a[i]
        elif a[i] == "--per-tab" and i + 1 < len(a):
            i += 1; per_tab = max(1, int(a[i]))
        elif a[i] == "--name" and i + 1 < len(a):
            i += 1; name = a[i]
        elif a[i] == "--dry-run":
            dry = True
        elif a[i] in ("--no-ui", "--all"):
            interactive = False          # take the whole window, no checkboxes
        elif a[i] == "--all-known":
            include_known = True
        elif a[i] in ("-h", "--help"):
            print(__doc__); return 0
        i += 1

    rows = collect(days, include_known)
    if rows is None:
        print("\n  Cannot tell which conversations are open right now, so nothing is offered.")
        print("  (Reopening one that is already open makes both copies write to the same")
        print("  transcript, which corrupts it.) Try again in a moment.\n")
        return 1
    if not rows:
        print("Nothing to restore — every conversation in that window already has a pane.")
        print("Widen it:  restore-plan -d 7")
        return 0

    # Narrow AFTER collecting, so the numbers you see in the list are the numbers you --pick.
    total = len(rows)
    if match:
        rows = [r for r in rows if match in r[3].lower() or match in os.path.basename(r[2]).lower()]

    # Checkboxes are the natural way to answer "which of these do you want back", so that is
    # the default when you are sitting at a terminal and haven't already said which ones.
    # Piped or scripted (not a tty), or narrowed explicitly, it stays non-interactive.
    if interactive and not pick and not limit and sys.stdin.isatty() and sys.stdout.isatty():
        chosen = choose(rows)
        if chosen is None:
            print("\n  Cancelled — nothing written, nothing opened.\n")
            return 0
        if chosen != "NOUI":
            if not chosen:
                print("\n  Nothing ticked — nothing written.\n")
                return 0
            rows = chosen

    if pick:
        want = parse_pick(pick, len(rows))
        if not want:
            print(f"\n  --pick {pick} selected nothing. Run it without --pick to see the list.\n")
            return 1
        rows = [rows[x - 1] for x in want]
    elif limit:
        rows = rows[:limit]
    if not rows:
        print(f"\n  Nothing matched. {total} conversation(s) were available before filtering.\n")
        return 1
    if len(rows) != total:
        print(f"\n  Narrowed to {len(rows)} of {total} — the rest are untouched and still there.")

    # Use the user's own wrapper when they have one, so env/routing matches their normal launch.
    import subprocess
    has_cc = subprocess.run(
        ["zsh", "-ic", "w=$(whence -w cc 2>/dev/null); "
                       "[[ \"$w\" == *': function' || \"$w\" == *': alias' ]]"],
        capture_output=True,
        env={**os.environ, "_SUPERSET_RESUME_DONE": "1"}).returncode == 0
    launcher = "cc all --resume %s" if has_cc else "claude --resume %s"

    # Every pane in this config launches the moment the window opens, so without a throttle a
    # 69-pane restore starts 69 agents in the same second. Wait for a start slot first; the
    # wait is a normal foreground command, so Ctrl-C in a pane just leaves it a plain shell.
    # Guarded on the file existing: if it is missing, launch unthrottled rather than let `&&`
    # swallow the launch and resume nothing.
    throttle = os.path.join(RECOV, "superset-resume")
    if os.access(throttle, os.X_OK):
        launcher = f"{shlex.quote(throttle)} wait-slot && " + launcher

    yaml, n_panes = build(rows, per_tab, name, launcher)
    # Say TABS when that is what it makes. "N panes" reads as N splits fighting for one
    # screen; the default is one tab per conversation, named after it, which you can drag
    # wherever you want afterwards. Getting this wrong is the difference between "that is
    # exactly what I wanted" and "that will never fit".
    if per_tab == 1:
        print(f"\n  {len(rows)} conversation(s) → {len(rows)} tab(s), one each, "
              f"every tab named after its conversation\n")
    else:
        print(f"\n  {len(rows)} conversation(s) → {n_panes} pane(s) "
              f"across {(len(rows) + per_tab - 1) // per_tab} tab(s)\n")
    for _m, sid, cwd, label in rows:
        print(f"    {os.path.basename(cwd)[:24]:24}  {label}")
    if dry:
        print("\n--- config (not written) ---\n"); print(yaml); return 0

    # Last look before writing something you can run with one keystroke. Checked again here,
    # not just during collection, because a conversation can be opened while you read the list.
    busy = busy_sids()
    if busy is None:
        print("\n  Cannot tell which conversations are open right now, so nothing is written.\n")
        return 1
    clash = [sid for _m, sid, _c, _l in rows if sid in busy]
    if clash:
        print(f"\n  Not writing it: {len(clash)} of these are open right now.")
        print("  Reopening an open conversation makes both copies write to the same")
        print("  transcript at once, which corrupts it. Close them, or re-run to skip them.")
        for sid in clash:
            print(f"     {sid}")
        print()
        return 1

    os.makedirs(LAUNCH_DIR, exist_ok=True)
    path = os.path.join(LAUNCH_DIR, f"{name}.yaml")
    # This is the one place the tool writes outside its own directory, into a folder the user
    # also authors by hand. A default name like "restore-sessions" is one someone could
    # plausibly have used themselves, and the write is a truncation — so an unmarked file gets
    # moved aside rather than replaced. Deliberately NOT a refusal: being unable to write the
    # plan would break the recovery this exists for. Keep the file, keep going, say where.
    saved = ""
    if os.path.exists(path):
        try:
            head = open(path, errors="ignore").readline()
        except OSError:
            head = MARKER          # unreadable -> treat as ours rather than block recovery
        if MARKER not in head:
            saved = path + ".bak"
            try:
                os.replace(path, saved)
            except OSError:
                saved = ""
    with open(path, "w") as fh:
        fh.write(yaml)
    if saved:
        print(f"\n  A file was already there and was not written by this tool.")
        print(f"  Kept it at {saved}")
    print(f"\n  Wrote {path}")
    print(f"\n  Open it:  Warp ⌘P → \"Launch Configuration\" → {name}")
    print("  Every pane comes back with its conversation. Nothing is opened until you run it.\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)

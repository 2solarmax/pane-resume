#!/usr/bin/env python3
"""
sess — find and reopen a Claude conversation, by what it was ABOUT.

Terminals lose which conversation was in which pane (a crash, a restart, a closed tab).
Every conversation is still on disk; this makes them findable and one keystroke to reopen.

  sess                 recent conversations (last 24h), newest first
  sess -d 7            last 7 days
  sess -a              all
  sess --lost          ONLY the ones no pane knows about — your restore checklist
  sess <text>          only ones whose first message matches <text>
  sess .               only ones from THIS folder
  sess <N>             reopen #N here (runs your `cc all --resume <id>`, or claude)
  sess <N> --print     just print the resume command, don't run it

Reads ~/.claude/projects. Never deletes anything.
"""
import os, sys, json, glob, time, subprocess, shutil

HOME = os.path.expanduser("~")
HOME_ENC = HOME.replace("/", "-")
PROJ = os.path.join(HOME, ".claude", "projects")

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import titlelib            # what to CALL a conversation — shared with every other surface


def label(path, limit=72):
    """The conversation's real NAME — the same title Claude shows you, and the same one the
    pane header and a restored tab will show. Searching by a name only this tool knows is
    how you end up reopening the wrong conversation."""
    return titlelib.name_of(path, limit, "(no text yet)")


def sessions(days=1.0, match=None, here=False):
    cutoff = time.time() - days * 86400
    cwd_enc = "".join(ch if ch.isalnum() else "-" for ch in os.getcwd())
    out = []
    for f in glob.glob(os.path.join(PROJ, "*", "*.jsonl")):
        try:
            m = os.path.getmtime(f)
        except OSError:
            continue
        if m < cutoff:
            continue
        proj = os.path.basename(os.path.dirname(f))
        if here and proj != cwd_enc:
            continue
        out.append((m, f, proj))
    out.sort(reverse=True)
    rows = []
    for m, f, proj in out:
        lb = label(f)
        if match and match.lower() not in lb.lower() and match.lower() not in proj.lower():
            continue
        rows.append((m, f, proj, lb))
    return rows


def claimed_sids():
    """Sessions that already have a pane of their own (a saved pane<->session record).
    Lets you see, at a glance, which conversations are homed and which are still
    orphaned — so restoring a workspace is a checklist, not a guessing game."""
    out = {}
    base = os.path.join(HOME, ".superset-recovery")
    for sub in ("warp-bindings", "warp-last"):
        d = os.path.join(base, sub)
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for pane in names:
            try:
                parts = open(os.path.join(d, pane)).read().strip().split("\t")
            except OSError:
                continue
            if len(parts) > 1:
                out.setdefault(parts[1], pane)
    return out


def show(rows):
    claimed = claimed_sids()
    if not rows:
        print("Nothing to show. Try a wider window:  sess -d 7   |   sess -a")
        return
    width = shutil.get_terminal_size((120, 24)).columns
    n_lost = sum(1 for r in rows if os.path.basename(r[1])[:-6] not in claimed)
    print(f"\n  {len(rows)} conversation(s) — {n_lost} not yet in any pane. "
          f"Reopen one with:  sess <number>")
    print("  ● = has a pane      ○ = orphaned (no pane knows about it)\n")
    for i, (m, f, proj, lb) in enumerate(rows, 1):
        sid = os.path.basename(f)[:-6]
        mark = "●" if sid in claimed else "○"
        when = time.strftime("%a %H:%M", time.localtime(m))
        # Claude encodes a project directory by replacing every "/" with "-", so the
        # encoded form of $HOME is just that same substitution — derived, never hardcoded.
        folder = proj.replace(HOME_ENC + "-", "~/").replace(HOME_ENC, "~")
        room = max(20, width - 36 - len(folder))
        print(f"  {i:>3}. {mark} {when:>9}  {folder[:30]:30}  {lb[:room]}")
    print()


def already_open(sid):
    """Is this conversation running somewhere right now?

    Two copies of one conversation both append to the same transcript and interleave it into
    nonsense. The other two restore paths have always checked; this one — the one you reach
    for most, because it is the one you type — did not. Uses the SAME definition of "open"
    rather than a second one, so there is no way for them to disagree.

    Unknown (the probe failed) is reported as unknown, not as safe."""
    try:
        import importlib.util
        from importlib.machinery import SourceFileLoader
        p = os.path.join(HOME, ".superset-recovery", "restore-plan")
        spec = importlib.util.spec_from_file_location(
            "restore_plan", p, loader=SourceFileLoader("restore_plan", p))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        busy = mod.busy_sids()
    except Exception:
        return None
    if busy is None:
        return None
    return sid in busy


def resume(rows, n, print_only=False):
    if not (1 <= n <= len(rows)):
        print(f"No #{n}. Run `sess` to see the list."); return 1
    m, f, proj, lb = rows[n - 1]
    sid = os.path.basename(f)[:-6]
    if not print_only:
        state = already_open(sid)
        if state is True:
            print(f"\n  Not reopening \"{lb}\" — it is open in another pane right now.")
            print("  Two copies of one conversation write to the same transcript at once,")
            print("  which corrupts it. Find that pane, or pick another number.\n")
            return 1
        if state is None:
            # Deliberately NOT fatal: you asked for this one conversation by name, and a
            # broken probe must not be able to lock you out of your own recovery.
            print("\n  (Could not check whether this conversation is open elsewhere —")
            print("   if it is already running in another pane, close that one first.)")
    # Prefer the user's own wrapper so their env/router is set up the same as always.
    # `whence -w cc` alone is NOT enough: every Mac with Xcode has /usr/bin/cc (the C
    # compiler), so a bare existence test passes and we would hand the resume to a compiler.
    # _SUPERSET_RESUME_DONE is NOT optional here. This probe sources the user's .zshrc, which
    # sources the resume hook, which registers the pane's own shell in warp-shell/. Without the
    # flag this transient subshell overwrites that record with ITS pid and then exits — leaving
    # the pane registered to a dead process, so restore-in-place later skips it as "no live
    # shell registered". That is the 2026-07-27 defect the hook's own comment documents; the
    # other two probes set it and this one did not, so every `sess <N>` quietly broke the
    # restorability of the pane it was run from.
    has_cc = subprocess.run(
        ["zsh", "-ic", "w=$(whence -w cc 2>/dev/null); "
                       "[[ \"$w\" == *': function' || \"$w\" == *': alias' ]]"],
        capture_output=True,
        env={**os.environ, "_SUPERSET_RESUME_DONE": "1"}).returncode == 0
    cmd = f"cc all --resume {sid}" if has_cc else f"claude --resume {sid}"
    if print_only:
        print(cmd); return 0
    print(f"\n  Reopening: {lb}\n  → {cmd}\n")
    # Same reason as the probe above, and the half that actually bites: this shell is
    # interactive, lives in the pane, and would otherwise re-register the pane as ITS pid.
    # When you quit the conversation this shell exits, and the pane is left pointing at a
    # dead process — so the next restore skips it. The pane's own long-lived shell is still
    # underneath and already correctly registered; it must stay the registered one.
    os.environ["_SUPERSET_RESUME_DONE"] = "1"
    os.execvp("zsh", ["zsh", "-ic", cmd])


def main():
    args = [a for a in sys.argv[1:]]
    days, match, here, print_only = 1.0, None, False, False
    only_lost = False
    pick = None
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-a":
            days = 3650
        elif a == "-d" and i + 1 < len(args):
            i += 1
            try: days = float(args[i])
            except ValueError: pass
        elif a == "--print":
            print_only = True
        elif a == ".":
            here = True
        elif a in ("--lost", "-l"):
            only_lost = True          # only conversations with no pane = your restore queue
        elif a.isdigit():
            pick = int(a)
        elif a in ("-h", "--help"):
            print(__doc__); return 0
        else:
            match = a
        i += 1
    # NOTE: listing and picking MUST use the same window/filters, or the numbers shift
    # and `sess 7` reopens a different conversation than the one you read. So pass the
    # same flags when picking (e.g. `sess -d 7 3`).
    rows = sessions(days=days, match=match, here=here)
    # Apply --lost BEFORE both listing and picking, so the numbers you read are the
    # numbers you pick. (Filtering only in show() made `sess --lost 3` open a different
    # conversation than the #3 printed.)
    if only_lost:
        claimed = claimed_sids()
        rows = [r for r in rows if os.path.basename(r[1])[:-6] not in claimed]
    if pick is not None:
        return resume(rows, pick, print_only)
    show(rows)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
